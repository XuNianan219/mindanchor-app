# ====== Supabase（前端直连，必填）======
# 在 Supabase 后台 → 项目 Settings → API 页面复制：
# VITE_SUPABASE_URL = 该页的 "Project URL"
# VITE_SUPABASE_ANON_KEY = 该页 "Project API keys" 里的 "anon / public" 公钥
# 注意：变量名必须以 VITE_ 开头，前端才能读到。把真实值填到 .env.local（不要提交）。
VITE_SUPABASE_URL="https://你的项目.supabase.co"
VITE_SUPABASE_ANON_KEY="你的-anon-public-公钥"

# ====== 以下为旧模板自带，暂未使用，可忽略 ======
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
