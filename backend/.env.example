# ====== 数据库连接（来自 Supabase）======
# 应用运行时用的连接地址，Supabase 推荐用带连接池的 6543 端口
DATABASE_URL="postgresql://用户名:密码@主机地址:6543/postgres?pgbouncer=true"

# Prisma 执行迁移（建表）时用的直连地址，Supabase 的 5432 端口
DIRECT_URL="postgresql://用户名:密码@主机地址:5432/postgres"

# ====== 登录凭证 JWT ======
# JWT 签名密钥，必须改成一段足够长的随机字符串，绝对不要泄露或提交到 git
JWT_SECRET="请替换成你自己的随机长字符串"
# token 有效期，例如 7d（7天）、12h（12小时）
JWT_EXPIRES_IN="7d"

# ====== 服务端口 ======
# 后端监听的端口（前端开发服务器用的是 3000，这里用 4000 避免冲突）
PORT=4000
