// Prisma 数据库结构定义文件
// 当前包含：users（用户）、sleep_records（睡眠记录）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 应用运行时使用的连接地址（Supabase 推荐用带连接池的 6543 端口）
  url      = env("DATABASE_URL")
  // Prisma 执行数据库迁移时使用的直连地址（Supabase 的 5432 端口）
  directUrl = env("DIRECT_URL")
}

// 用户表
model User {
  // 主键，用 UUID 字符串，避免自增 ID 被外部猜测
  id           String   @id @default(uuid())
  // 登录账号：邮箱或手机号都可以，用字符串存；不允许重复
  account      String   @unique
  // bcrypt 加密后的密码（绝不存明文密码）
  passwordHash String   @map("password_hash")
  // 昵称，可为空
  nickname     String?
  // 创建时间，默认当前时间
  createdAt    DateTime @default(now()) @map("created_at")

  // 反向关系：一个用户有多条睡眠记录
  sleepRecords SleepRecord[]

  // 数据库里的真实表名用 users（符合你要求的命名）
  @@map("users")
}

// 睡眠记录表：用户每完成（或退出）一次助眠引导，存一条
model SleepRecord {
  // 主键
  id              String   @id @default(uuid())
  // 所属用户的 id
  userId          String   @map("user_id")
  // 关联到 User；用户被删除时，其睡眠记录一并删除
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 本次设定的时长（分钟），对应前端的 5/10/20/30
  durationMinutes Int      @map("duration_minutes")
  // 是否走完了整个引导（false 表示中途退出）
  completed       Boolean  @default(false)
  // 备注，可空（以后可放心情、白噪音类型等）
  note            String?
  // 记录创建时间
  createdAt       DateTime @default(now()) @map("created_at")

  // 按 userId 建索引，加快"查某用户的记录"
  @@index([userId])
  @@map("sleep_records")
}
